<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#EAF1F4"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="18dp">

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Мои настройки"
            android:textColor="#211A3A"
            android:textSize="26sp"
            android:textStyle="bold" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:background="@drawable/bg_map_header"
            android:orientation="vertical"
            android:padding="18dp">

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Радиус уведомления рядом"
                android:textSize="17sp"
                android:textStyle="bold" />

            <SeekBar
                android:id="@+id/radiusSeekBar"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:max="975"
                android:progress="225" />

            <TextView
                android:id="@+id/radiusValue"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Радиус уведомления: 250 м"
                android:textColor="#68717D"
                android:textSize="15sp" />

            <androidx.appcompat.widget.SwitchCompat
                android:id="@+id/shareSwitch"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="18dp"
                android:text="Делиться моей геопозицией"
                android:textSize="16sp" />

            <androidx.appcompat.widget.SwitchCompat
                android:id="@+id/gpsSwitch"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:text="Обновлять локацию в реальном времени (GPS)"
                android:textSize="16sp" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="20dp"
                android:text="Моя локация"
                android:textStyle="bold"
                android:textSize="18sp" />

            <TextView
                android:id="@+id/locationText"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Ожидание координат GPS…"
                android:textColor="#68717D"
                android:textSize="15sp" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                android:text="Ближайший участник"
                android:textStyle="bold"
                android:textSize="18sp" />

            <TextView
                android:id="@+id/nearestUserText"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Участники появятся после подключения сервера комнаты."
                android:textColor="#68717D"
                android:textSize="15sp" />
        </LinearLayout>
    </LinearLayout>
</ScrollView>
